---
interface Props {
  title?: string;
}

const { title = 'Streak Tracker' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content="Track your daily habits and build streaks" />
    <meta name="application-name" content="Streak Tracker" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Streaks" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/streak-manifest.webmanifest" />

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/icons/streak-icon-192x192.png" />
    <link rel="apple-touch-icon" href="/icons/streak-apple-touch-icon.png" />

    <!-- Theme Color (Terminal dark) -->
    <meta name="theme-color" content="#030712" />

    <!-- Tailwind CSS -->
    <style is:global>
      @import '../styles/global.css';
    </style>

    <!-- TUI Terminal Styles -->
    <style>
      body {
        background: #030712; /* gray-950 - terminal dark */
        min-height: 100vh;
        font-family: ui-monospace, 'Courier New', monospace;
        color: #f9fafb; /* gray-50 - terminal light text */
      }
    </style>
  </head>
  <body>
    <slot />

    <!-- Register Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/streak-sw.js')
            .then((registration) => {
              console.log('Service Worker registered:', registration);
            })
            .catch((error) => {
              console.log('Service Worker registration failed:', error);
            });
        });
      }
    </script>
  </body>
</html>
