---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';

// Get all blog posts
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Blog | alsasian.github.io"
  description="Technical writing and notes on software engineering"
>
  <Header />
  <main class="max-w-5xl mx-auto px-4 py-6">
    <article class="border-b border-gray-300 pb-4 mb-6">
      <h1 class="text-4xl mb-2">Blog</h1>
      <p class="text-sm text-gray-600">
        Technical writing, notes, and thoughts on software engineering
      </p>
    </article>

    {posts.length === 0 ? (
      <div class="border-l-4 border-gray-300 pl-3 py-4">
        <p class="text-gray-600">No posts yet. Check back soon!</p>
      </div>
    ) : (
      <div class="space-y-6">
        {posts.map((post) => (
          <article class="border-b border-gray-200 pb-4">
            <h2 class="text-2xl mb-1">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h2>
            <p class="text-sm text-gray-600 mb-2">
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </p>
            {post.data.description && (
              <p class="text-sm mb-2">{post.data.description}</p>
            )}
            <a href={`/blog/${post.slug}`} class="text-sm font-bold">
              Read more →
            </a>
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>
