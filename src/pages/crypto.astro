---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import WebCryptoPlayground from '../components/WebCryptoPlayground';
---

<Layout
  title="WebCrypto Playground | alsasian.github.io"
  description="Interactive playground for experimenting with the Web Cryptography API"
>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-6">
    <article class="mb-6 border-b border-gray-300 pb-4 dark:border-gray-700">
      <h1 class="mb-2 text-4xl">WebCrypto Playground</h1>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Interactive experiments with the Web Cryptography API
      </p>
    </article>
    <WebCryptoPlayground client:load />
  </main>
</Layout>
