---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="alsasian.github.io">
  <Header />
  <main class="max-w-5xl mx-auto px-4 py-6">
    <article class="border-b border-gray-300 pb-4 mb-4">
      <h1 class="text-4xl mb-2">alsasian.github.io</h1>
      <p class="text-sm text-gray-600 mb-3">Personal website and technical experiments</p>
      <p class="mb-2">
        This site serves as a personal space for technical writing, experiments, and projects.
        Built with Astro, React, TypeScript, and Tailwind CSS. Deployed on GitHub Pages.
      </p>
    </article>

    <div class="grid md:grid-cols-2 gap-6 mb-6">
      <section class="border-l-4 border-gray-900 pl-3">
        <h2 class="text-2xl mb-2">WebCrypto Playground</h2>
        <p class="mb-2 text-sm">
          An interactive playground for experimenting with the Web Cryptography API.
          Hash, encrypt, decrypt, and generate cryptographic keys directly in the browser.
        </p>
        <a href="/crypto" class="text-sm font-bold">
          Visit Playground →
        </a>
      </section>

      <section class="border-l-4 border-gray-900 pl-3">
        <h2 class="text-2xl mb-2">Blog</h2>
        <p class="mb-2 text-sm">
          Technical writing, notes, and thoughts on software engineering, cryptography,
          and web technologies.
        </p>
        <a href="/blog" class="text-sm font-bold">
          Read Blog →
        </a>
      </section>
    </div>

    <section class="border-t border-gray-300 pt-4 mt-6">
      <h2 class="text-xl mb-2">Recent Updates</h2>
      <ul class="space-y-1 text-sm">
        <li>
          <span class="text-gray-600">2025-11-08</span> —
          <span>Site redesigned with newspaper-inspired layout</span>
        </li>
        <li>
          <span class="text-gray-600">2025-11-08</span> —
          <a href="/crypto">WebCrypto Playground launched</a>
        </li>
        <li>
          <span class="text-gray-600">2025-11-08</span> —
          <span>Initial site setup with Astro</span>
        </li>
      </ul>
    </section>

    <footer class="border-t border-gray-300 mt-8 pt-4 text-sm text-gray-600">
      <p>
        <a href="https://github.com/alsasian" target="_blank" rel="noopener noreferrer">GitHub</a>
      </p>
    </footer>
  </main>
</Layout>
